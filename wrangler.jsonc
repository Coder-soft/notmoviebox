{
  "name": "notmoviebox",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // The MovieBox API 429s Cloudflare's egress IPs, so the Worker cannot call it
  // directly. Set RELAY_BASE to a relay that can (your machine via a Cloudflare
  // Tunnel, a VPS, or a non-Cloudflare free host) and the Worker injects it into
  // index.html as <meta name="proxy-base">, making the Workers URL fully work.
  //
  //   wrangler secret put RELAY_BASE        # or add to "vars" below
  //
  "vars": {
    "RELAY_BASE": ""
  }
}
